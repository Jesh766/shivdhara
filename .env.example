# GEMINI_API_KEY: Required for Gemini AI API calls for Dhara AI assistant.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# TELEGRAM: For instant team notifications when visitors request human handoff
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# WHATSAPP: Floating WhatsApp CTA and Direct Order Number (e.g., +916359666315)
WHATSAPP_ORDER_NUMBER="+916359666315"
WHATSAPP_NUMBER="+916359666315"

# UPI PAYMENT: Configurable UPI ID and optional custom QR code image URL
UPI_ID="shivdhara@upi"
UPI_QR_IMAGE_URL=""


# EMAIL: For transactional notifications
EMAIL_FROM="contact@shivdhara.com"
EMAIL_API_KEY=""

# MICROSOFT CLARITY: Free live visitor recordings, button click heatmaps, and page analytics
VITE_CLARITY_PROJECT_ID=""

# ADMIN PORTAL: Passcode to access /#/admin master dashboard and editor API
ADMIN_TOKEN="CHANGE_THIS_TO_A_PRIVATE_PASSWORD"
ADMIN_PASSWORD="CHANGE_THIS_TO_A_PRIVATE_PASSWORD"

# HOSTING PORT (Default: 3000)
PORT=3000

